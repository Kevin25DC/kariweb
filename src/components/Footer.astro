---
import { socials } from "../lib/socials";

const repo = "https://github.com/Kevin25DC/karina-token";
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="#top" class="flex items-center gap-2.5">
          <img src="/logo-icon.png" alt="Karina" class="h-8 w-8 rounded-[9px]" />
          <span class="text-[15px] font-semibold tracking-tight text-text">Karina</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">
          Monitor de consumo de IA en tiempo casi real, local-first, para escritorio.
          Construida con Go, Wails y React.
        </p>
        <div class="mt-5 flex items-center gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noreferrer"
              aria-label={s.label}
              class={`flex h-9 w-9 items-center justify-center rounded-full border border-border text-muted transition-colors ${s.hover} hover:border-white/25`}
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-muted">Producto</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="#features" class="text-muted transition-colors hover:text-text">Funciones</a></li>
          <li><a href="#showcase" class="text-muted transition-colors hover:text-text">Capturas</a></li>
          <li><a href="#how" class="text-muted transition-colors hover:text-text">Cómo funciona</a></li>
          <li><a href={`${repo}/releases`} target="_blank" rel="noreferrer" class="text-muted transition-colors hover:text-text">Descargas</a></li>
          <li><a href="#apoyo" class="text-muted transition-colors hover:text-text">Apóyame</a></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-muted">Proyecto</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href={repo} target="_blank" rel="noreferrer" class="text-muted transition-colors hover:text-text">Código fuente</a></li>
          <li><a href={`${repo}/issues`} target="_blank" rel="noreferrer" class="text-muted transition-colors hover:text-text">Reportar un problema</a></li>
          <li><a href={`${repo}/releases`} target="_blank" rel="noreferrer" class="text-muted transition-colors hover:text-text">Changelog</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 text-xs text-muted/80 sm:flex-row">
      <p>© {year} Karina. Hecho por Kevin Hernández - Berserkerdev.</p>
      <p>Go · Wails v2 · React · Astro</p>
    </div>
  </div>
</footer>
