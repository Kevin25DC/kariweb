---
const steps = [
  {
    n: "01",
    title: "Conecta tu proveedor",
    desc: "Añade tu API key o inicia sesión con Claude Code. Se guarda cifrada en el keyring de tu sistema, nunca en un archivo.",
  },
  {
    n: "02",
    title: "Karina monitorea en segundo plano",
    desc: "Polling silencioso con el intervalo que definas, actualización del tray y del widget, cero fricción.",
  },
  {
    n: "03",
    title: "Recibe alertas antes del límite",
    desc: "Toast dentro de la app cuando cruzas tu umbral configurado, y el historial siempre a mano para revisar.",
  },
];
---

<section id="how" class="relative mx-auto max-w-6xl px-6 py-28">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="reveal text-3xl font-bold tracking-tight sm:text-4xl">Cómo funciona</h2>
    <p class="reveal mt-4 text-muted" style="transition-delay: 80ms">Tres pasos, sin backend propio de por medio.</p>
  </div>

  <div class="relative mt-16 grid gap-10 sm:grid-cols-3">
    <div class="pointer-events-none absolute left-0 right-0 top-6 hidden h-px bg-gradient-to-r from-transparent via-border to-transparent sm:block"></div>
    {steps.map((s, i) => (
      <div class="reveal relative flex flex-col items-center text-center" style={`transition-delay: ${i * 100}ms`}>
        <div class="glow-border relative z-10 mb-6 flex h-12 w-12 items-center justify-center rounded-full border border-border bg-surface font-mono text-sm text-cyan">
          {s.n}
        </div>
        <h3 class="text-lg font-semibold text-text">{s.title}</h3>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted">{s.desc}</p>
      </div>
    ))}
  </div>
</section>
