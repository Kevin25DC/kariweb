---
const links = [
  { href: "#features", label: "Funciones" },
  { href: "#providers", label: "Proveedores" },
  { href: "#showcase", label: "Capturas" },
  { href: "#how", label: "Cómo funciona" },
  { href: "#apoyo", label: "Apóyame" },
];
const repo = "https://github.com/Kevin25DC/karina-token";
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-colors duration-300">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="#top" class="flex items-center gap-2.5">
      <img src="/logo-icon.png" alt="Karina" class="h-8 w-8 rounded-[9px]" />
      <span class="text-[15px] font-semibold tracking-tight text-text">Karina</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-muted transition-colors hover:text-text">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={repo}
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-2 rounded-full border border-border px-4 py-2 text-sm text-muted transition-colors hover:border-white/20 hover:text-text sm:flex"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.72.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .3.2.66.79.55A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
        GitHub
      </a>
      <a
        href={`${repo}/releases/latest`}
        target="_blank"
        rel="noreferrer"
        class="btn-gradient rounded-full px-4 py-2 text-sm font-medium text-ink transition-transform hover:scale-[1.03]"
      >
        Descargar
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    if (!nav) return;
    if (window.scrollY > 12) {
      nav.classList.add("bg-bg/70", "backdrop-blur-lg", "border-b", "border-border");
    } else {
      nav.classList.remove("bg-bg/70", "backdrop-blur-lg", "border-b", "border-border");
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
