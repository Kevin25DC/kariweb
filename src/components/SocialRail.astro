---
import { socials } from "../lib/socials";
---

<div class="fixed right-5 top-1/2 z-40 hidden -translate-y-1/2 lg:flex lg:flex-col lg:items-center">
  <span class="mb-3 origin-center -rotate-90 whitespace-nowrap text-[10px] font-medium uppercase tracking-[0.25em] text-muted">
    Sígueme
  </span>
  <div class="h-8 w-px bg-gradient-to-b from-transparent to-border"></div>
  <div class="mt-3 flex flex-col gap-1 rounded-full border border-border bg-surface/70 p-2 backdrop-blur">
    {socials.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noreferrer"
        aria-label={s.label}
        class={`flex h-9 w-9 items-center justify-center rounded-full text-muted transition-all duration-200 hover:scale-110 hover:bg-white/5 ${s.hover}`}
      >
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
      </a>
    ))}
  </div>
</div>
